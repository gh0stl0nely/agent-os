{
  "skill": "claim-evidence-audit",
  "cases": [
    {
      "id": "all-claims-verified",
      "kind": "normal",
      "why": "A correct number and a supported fact: both pass, the envelope says ok, and every output row fits the claim-ledger contract.",
      "steps": [
        {
          "cmd": [
            "python3",
            "{skill}/scripts/audit.py",
            "--envelope",
            "{fx}/scenarios/ok/envelope.json",
            "--ledger",
            "{fx}/scenarios/ok/ledger.jsonl",
            "--root",
            "{fx}/root",
            "--rubric",
            "{repo}/agents/02-verifier/rubrics/example-invoice.md",
            "--now",
            "2026-10-07T12:00:00-04:00",
            "--out",
            "{tmp}",
            "--specs",
            "{fx}/scenarios/ok/specs.json",
            "--judgments",
            "{fx}/scenarios/ok/judgments.json"
          ],
          "expect_exit": 0,
          "files": {
            "{tmp}/audit-report.json": [
              {
                "path": "claims[claim_id=C-fx-total].result",
                "equals": "pass"
              },
              {
                "path": "claims[claim_id=C-fx-cutoff].result",
                "equals": "pass"
              },
              {
                "path": "claims[claim_id=C-fx-total].reason_codes",
                "contains": "verified"
              },
              {
                "path": "claims[claim_id=C-fx-cutoff].reason_codes",
                "contains": "verified"
              }
            ],
            "{tmp}/audit-envelope.json": [
              {
                "path": "status",
                "equals": "ok"
              },
              {
                "path": "from_agent",
                "equals": "02-verifier"
              }
            ]
          },
          "validate": [
            {
              "schema": "agent-envelope",
              "file": "{tmp}/audit-envelope.json"
            },
            {
              "schema": "claim-ledger",
              "file": "{tmp}/audit-ledger.jsonl"
            }
          ]
        }
      ]
    },
