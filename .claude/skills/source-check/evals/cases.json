{
  "skill": "source-check",
  "cases": [
    {
      "id": "supported-passes",
      "kind": "normal",
      "why": "Current source, verbatim quote, number present, judge says it supports the claim.",
      "cmd": [
        "python3",
        "{skill}/scripts/source_check.py",
        "check",
        "--claim",
        "{fx}/claims/supported.json",
        "--evidence-index",
        "0",
        "--root",
        "{fx}",
        "--now",
        "2026-10-07T12:00:00-04:00",
        "--max-age-days",
        "365",
        "--judgments",
        "{fx}/judgments.json"
      ],
      "expect_exit": 0,
      "stdout_json": [
        {
          "path": "result",
          "equals": "pass"
        },
        {
          "path": "reason_code",
          "equals": "supported"
        }
      ]
    },
