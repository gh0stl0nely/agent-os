{
  "_comment": "PROPOSED by the Guardian. Not active until the owner merges it into .claude/settings.json (an R2 action: Preflight Brief). Keep $CLAUDE_PROJECT_DIR so the hooks work from any folder. Test with agents/03-guardian/hooks/test_hooks.py first.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/agents/03-guardian/hooks/guard_bash.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/agents/03-guardian/hooks/guard_write.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/agents/03-guardian/hooks/guard_bash.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
